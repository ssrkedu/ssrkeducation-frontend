{
  "name": "admin-portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/admin-portal/src",
  "tags": ["scope:admin", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/admin-portal",
        "browser": "apps/admin-portal/src/main.ts",
        "tsConfig": "apps/admin-portal/tsconfig.app.json",
        "styles": ["apps/admin-portal/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/admin-portal/src/environments/environment.ts",
              "with": "apps/admin-portal/src/environments/environment.prod.ts"
            }
          ]
        },
        "local": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/admin-portal/src/environments/environment.ts",
              "with": "apps/admin-portal/src/environments/environment.local.ts"
            }
          ]
        },
        "dev": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/admin-portal/src/environments/environment.ts",
              "with": "apps/admin-portal/src/environments/environment.dev.ts"
            }
          ]
        },
        "qa": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/admin-portal/src/environments/environment.ts",
              "with": "apps/admin-portal/src/environments/environment.qa.ts"
            }
          ]
        },
        "uat": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/admin-portal/src/environments/environment.ts",
              "with": "apps/admin-portal/src/environments/environment.uat.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/admin-portal/src/environments/environment.ts",
              "with": "apps/admin-portal/src/environments/environment.local.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "local",
      "configurations": {
        "production": {
          "buildTarget": "admin-portal:build:production"
        },
        "local": {
          "buildTarget": "admin-portal:build:local"
        },
        "dev": {
          "buildTarget": "admin-portal:build:dev"
        },
        "qa": {
          "buildTarget": "admin-portal:build:qa"
        },
        "uat": {
          "buildTarget": "admin-portal:build:uat"
        },
        "development": {
          "buildTarget": "admin-portal:build:local",
          "proxyConfig": "apps/admin-portal/proxy.conf.json"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/admin-portal/jest.config.cts",
        "tsConfig": "apps/admin-portal/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "admin-portal:build",
        "staticFilePath": "dist/apps/admin-portal/browser",
        "spa": true
      }
    }
  }
}
