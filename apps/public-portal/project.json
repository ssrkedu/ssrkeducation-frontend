{

  "name": "public-portal",

  "$schema": "../../node_modules/nx/schemas/project-schema.json",

  "projectType": "application",

  "prefix": "app",

  "sourceRoot": "apps/public-portal/src",

  "tags": ["scope:public", "type:app"],

  "targets": {

    "build": {

      "executor": "@angular/build:application",

      "outputs": ["{options.outputPath}"],

      "defaultConfiguration": "production",

      "options": {

        "outputPath": "dist/apps/public-portal",

        "browser": "apps/public-portal/src/main.ts",

        "tsConfig": "apps/public-portal/tsconfig.app.json",

        "styles": ["apps/public-portal/src/styles.css"],

        "assets": [

          {

            "glob": "**/*",

            "input": "apps/public-portal/public",

            "output": "/"

          }

        ]

      },

      "configurations": {

        "production": {

          "budgets": [

            {

              "type": "initial",

              "maximumWarning": "500kb",

              "maximumError": "1mb"

            },

            {

              "type": "anyComponentStyle",

              "maximumWarning": "4kb",

              "maximumError": "8kb"

            }

          ],

          "outputHashing": "all"

        },

        "local": {

          "optimization": false,

          "extractLicenses": false,

          "sourceMap": true,

          "fileReplacements": [

            {

              "replace": "apps/public-portal/src/environments/environment.ts",

              "with": "apps/public-portal/src/environments/environment.local.ts"

            }

          ]

        },

        "dev": {

          "optimization": false,

          "extractLicenses": false,

          "sourceMap": true,

          "fileReplacements": [

            {

              "replace": "apps/public-portal/src/environments/environment.ts",

              "with": "apps/public-portal/src/environments/environment.dev.ts"

            }

          ]

        },

        "qa": {

          "optimization": false,

          "extractLicenses": false,

          "sourceMap": true,

          "fileReplacements": [

            {

              "replace": "apps/public-portal/src/environments/environment.ts",

              "with": "apps/public-portal/src/environments/environment.qa.ts"

            }

          ]

        }

      }

    },

    "serve": {

      "continuous": true,

      "executor": "@angular/build:dev-server",

      "defaultConfiguration": "local",

      "options": {

        "host": "0.0.0.0",

        "allowedHosts": ["localhost", ".lvh.me"]

      },

      "configurations": {

        "production": {

          "buildTarget": "public-portal:build:production"

        },

        "local": {

          "buildTarget": "public-portal:build:local"

        },

        "dev": {

          "buildTarget": "public-portal:build:dev"

        },

        "qa": {

          "buildTarget": "public-portal:build:qa"

        }

      }

    },

    "lint": {

      "executor": "@nx/eslint:lint"

    },

    "test": {

      "executor": "@nx/jest:jest",

      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],

      "options": {

        "jestConfig": "apps/public-portal/jest.config.cts",

        "tsConfig": "apps/public-portal/tsconfig.spec.json"

      }

    },

    "serve-static": {

      "continuous": true,

      "executor": "@nx/web:file-server",

      "options": {

        "buildTarget": "public-portal:build",

        "staticFilePath": "dist/apps/public-portal/browser",

        "spa": true

      }

    }

  }

}


